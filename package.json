{
  "name": "speedwall-lab",
  "private": true,
  "version": "0.0.0",
  "description": "Speedwall Lab: see how your speed limits your maneuvers (Star Citizen fan project).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:physics": "vitest run --project physics",
    "test:all": "vitest run",
    "size": "pnpm build && size-limit",
    "check:licenses": "node tools/check-licenses.mjs",
    "check:reuse": "reuse lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:licenses",
    "build:alpha": "pnpm build && node tools/build-alpha.mjs",
    "fit": "pnpm build && node tools/fit-gladius.mjs --fit --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
